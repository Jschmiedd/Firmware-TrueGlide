diff --git a/src/platform/STM32/simulee/carte_simulee.h b/src/platform/STM32/simulee/carte_simulee.h
new file mode 100644
index 0000000..80ca43f
--- /dev/null
+++ b/src/platform/STM32/simulee/carte_simulee.h
@@ -0,0 +1,57 @@
+/*
+ * TrueGlide - carte simulée : le firmware d'une vraie carte STM32F4, compilé pour l'ordinateur ou le navigateur.
+ * Free software under the GPL-3.0 license, WITHOUT ANY WARRANTY; see the LICENSE file.
+ *
+ * Inclus à la fin de platform/platform.h quand TG_CARTE_SIMULEE est défini (jamais dans une vraie construction).
+ * Les registres du microcontrôleur deviennent de la mémoire ordinaire : les adresses de base des périphériques
+ * (définies par l'en-tête du fabricant et par CMSIS) sont redéfinies vers des tableaux de la carte simulée. Les
+ * macros étant développées à l'usage, toutes les adresses qui en dérivent (TIM1, SPI1, GPIOA, DMA2_Stream0, SCB…)
+ * suivent. Le code de la vraie carte, ses tables (broches, timers, DMA) et ses réglages restent inchangés.
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+// tailles des zones simulées (registres du F4)
+#define TG_PERIPH_TAILLE   0x00080000u   // APB1, APB2, AHB1 : 0x40000000 - 0x4007FFFF
+#define TG_AHB2_TAILLE     0x00061000u   // AHB2 (USB OTG FS, RNG) : 0x50000000 - 0x50060FFF
+#define TG_COEUR_TAILLE    0x00043000u   // ITM, DWT, SCS (NVIC, SCB, SysTick), TPI, DBGMCU : 0xE0000000 - 0xE0042FFF
+
+// la vraie carte calcule en virgule flottante matérielle (__FPU_USED = 1) : certaines valeurs par défaut en
+// dépendent (nombre de voies AUX) ; sur l'ordinateur, CMSIS le met à 0
+#undef __FPU_USED
+#define __FPU_USED 1U
+
+// zone des réglages : 16 Ko dans la mémoire flash de la STM32F405 (secteur 1)
+#define TG_CONFIG_TAILLE   (16 * 1024)
+
+extern uint8_t tgPeripheriques[TG_PERIPH_TAILLE];
+extern uint8_t tgAhb2[TG_AHB2_TAILLE];
+extern uint8_t tgCoeur[TG_COEUR_TAILLE];
+extern uint32_t tgIdentifiantUnique[3];
+
+// mémoire système de la puce (0x1FFF7800 - 0x1FFF7A2F : zone OTP, identifiant unique, taille de la flash, étalonnages)
+#define TG_SYSTEME_TAILLE  0x230u
+extern uint8_t tgSysteme[TG_SYSTEME_TAILLE];
+#define TG_SYSTEME(adresse) ((uintptr_t)tgSysteme + ((adresse) - 0x1FFF7800UL))
+
+#undef PERIPH_BASE
+#define PERIPH_BASE        ((uintptr_t)tgPeripheriques)
+#undef AHB2PERIPH_BASE
+#define AHB2PERIPH_BASE    ((uintptr_t)tgAhb2)
+
+#define TG_COEUR(adresse)  ((uintptr_t)tgCoeur + ((adresse) - 0xE0000000UL))
+#undef ITM_BASE
+#define ITM_BASE           TG_COEUR(0xE0000000UL)
+#undef DWT_BASE
+#define DWT_BASE           TG_COEUR(0xE0001000UL)
+#undef SCS_BASE
+#define SCS_BASE           TG_COEUR(0xE000E000UL)
+#undef CoreDebug_BASE
+#define CoreDebug_BASE     TG_COEUR(0xE000EDF0UL)
+#undef TPI_BASE
+#define TPI_BASE           TG_COEUR(0xE0040000UL)
+#undef DBGMCU_BASE
+#define DBGMCU_BASE        TG_COEUR(0xE0042000UL)
+
diff --git a/src/platform/STM32/simulee/cmsis_hote.h b/src/platform/STM32/simulee/cmsis_hote.h
new file mode 100644
index 0000000..2de959f
--- /dev/null
+++ b/src/platform/STM32/simulee/cmsis_hote.h
@@ -0,0 +1,126 @@
+/*
+ * TrueGlide - carte simulée : fonctions CMSIS du cœur ARM Cortex-M pour l'ordinateur ou le navigateur.
+ * Free software under the GPL-3.0 license, WITHOUT ANY WARRANTY; see the LICENSE file.
+ *
+ * Inclus avant tout autre fichier (-include) dans la construction de la carte simulée : il prend la place de
+ * cmsis_gcc.h, dont les instructions ARM (interruptions, barrières mémoire, attente) n'existent pas ailleurs. La carte
+ * simulée n'a pas d'interruptions : les activer ou les couper ne fait rien ; le niveau BASEPRI est simulé par
+ * build/atomic.h.
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#define __CMSIS_GCC_H
+
+#ifndef __has_builtin
+#define __has_builtin(x) (0)
+#endif
+
+#define __ASM                                  __asm
+#define __INLINE                               inline
+#define __STATIC_INLINE                        static inline
+#define __STATIC_FORCEINLINE                   __attribute__((always_inline)) static inline
+#define __NO_RETURN                            __attribute__((__noreturn__))
+#define __USED                                 __attribute__((used))
+#define __WEAK                                 __attribute__((weak))
+#define __PACKED                               __attribute__((packed, aligned(1)))
+#define __PACKED_STRUCT                        struct __attribute__((packed, aligned(1)))
+#define __PACKED_UNION                         union __attribute__((packed, aligned(1)))
+#define __ALIGNED(x)                           __attribute__((aligned(x)))
+#define __RESTRICT                             __restrict
+#define __COMPILER_BARRIER()                   __asm volatile("" ::: "memory")
+
+struct __attribute__((packed)) T_UINT32 { uint32_t v; };
+struct __attribute__((packed, aligned(1))) T_UINT16_WRITE { uint16_t v; };
+struct __attribute__((packed, aligned(1))) T_UINT16_READ { uint16_t v; };
+struct __attribute__((packed, aligned(1))) T_UINT32_WRITE { uint32_t v; };
+struct __attribute__((packed, aligned(1))) T_UINT32_READ { uint32_t v; };
+#define __UNALIGNED_UINT32(x)                  (((struct T_UINT32 *)(x))->v)
+#define __UNALIGNED_UINT16_WRITE(addr, val)    (void)((((struct T_UINT16_WRITE *)(void *)(addr))->v) = (val))
+#define __UNALIGNED_UINT16_READ(addr)          (((const struct T_UINT16_READ *)(const void *)(addr))->v)
+#define __UNALIGNED_UINT32_WRITE(addr, val)    (void)((((struct T_UINT32_WRITE *)(void *)(addr))->v) = (val))
+#define __UNALIGNED_UINT32_READ(addr)          (((const struct T_UINT32_READ *)(const void *)(addr))->v)
+
+// interruptions : aucune dans la carte simulée
+extern uint32_t tgPrimask;
+__STATIC_FORCEINLINE void __enable_irq(void) { tgPrimask = 0; }
+__STATIC_FORCEINLINE void __disable_irq(void) { tgPrimask = 1; }
+__STATIC_FORCEINLINE uint32_t __get_PRIMASK(void) { return tgPrimask; }
+__STATIC_FORCEINLINE void __set_PRIMASK(uint32_t priMask) { tgPrimask = priMask; }
+__STATIC_FORCEINLINE void __enable_fault_irq(void) { }
+__STATIC_FORCEINLINE void __disable_fault_irq(void) { }
+__STATIC_FORCEINLINE uint32_t __get_FAULTMASK(void) { return 0; }
+__STATIC_FORCEINLINE void __set_FAULTMASK(uint32_t faultMask) { (void)faultMask; }
+__STATIC_FORCEINLINE uint32_t __get_CONTROL(void) { return 0; }
+__STATIC_FORCEINLINE void __set_CONTROL(uint32_t control) { (void)control; }
+__STATIC_FORCEINLINE uint32_t __get_IPSR(void) { return 0; }      // jamais dans une interruption
+__STATIC_FORCEINLINE uint32_t __get_APSR(void) { return 0; }
+__STATIC_FORCEINLINE uint32_t __get_xPSR(void) { return 0; }
+__STATIC_FORCEINLINE uint32_t __get_PSP(void) { return 0; }
+__STATIC_FORCEINLINE void __set_PSP(uint32_t topOfProcStack) { (void)topOfProcStack; }
+__STATIC_FORCEINLINE uint32_t __get_MSP(void) { return (uint32_t)(uintptr_t)__builtin_frame_address(0); }
+__STATIC_FORCEINLINE void __set_MSP(uint32_t topOfMainStack) { (void)topOfMainStack; }
+__STATIC_FORCEINLINE uint32_t __get_FPSCR(void) { return 0; }
+__STATIC_FORCEINLINE void __set_FPSCR(uint32_t fpscr) { (void)fpscr; }
+
+// attente, barrières : rien à attendre
+#define __NOP()                                __asm volatile ("" ::: "memory")
+#define __WFI()                                __asm volatile ("" ::: "memory")
+#define __WFE()                                __asm volatile ("" ::: "memory")
+#define __SEV()                                __asm volatile ("" ::: "memory")
+#define __BKPT(value)                          ((void)(value))
+__STATIC_FORCEINLINE void __ISB(void) { __COMPILER_BARRIER(); }
+__STATIC_FORCEINLINE void __DSB(void) { __COMPILER_BARRIER(); }
+__STATIC_FORCEINLINE void __DMB(void) { __COMPILER_BARRIER(); }
+
+// calculs sur les bits
+__STATIC_FORCEINLINE uint32_t __REV(uint32_t value) { return __builtin_bswap32(value); }
+__STATIC_FORCEINLINE uint32_t __REV16(uint32_t value) { return ((value & 0x00ff00ffu) << 8) | ((value >> 8) & 0x00ff00ffu); }
+__STATIC_FORCEINLINE int16_t __REVSH(int16_t value) { return (int16_t)__builtin_bswap16((uint16_t)value); }
+__STATIC_FORCEINLINE uint32_t __ROR(uint32_t op1, uint32_t op2)
+{
+    op2 %= 32u;
+    return op2 ? (op1 >> op2) | (op1 << (32u - op2)) : op1;
+}
+__STATIC_FORCEINLINE uint32_t __RBIT(uint32_t value)
+{
+    uint32_t r = 0;
+    for (int i = 0; i < 32; i++) {
+        r = (r << 1) | ((value >> i) & 1u);
+    }
+    return r;
+}
+__STATIC_FORCEINLINE uint8_t __CLZ(uint32_t value) { return value ? (uint8_t)__builtin_clz(value) : 32u; }
+
+// accès exclusifs : un seul fil, ils réussissent toujours
+__STATIC_FORCEINLINE uint8_t __LDREXB(volatile uint8_t *addr) { return *addr; }
+__STATIC_FORCEINLINE uint16_t __LDREXH(volatile uint16_t *addr) { return *addr; }
+__STATIC_FORCEINLINE uint32_t __LDREXW(volatile uint32_t *addr) { return *addr; }
+__STATIC_FORCEINLINE uint32_t __STREXB(uint8_t value, volatile uint8_t *addr) { *addr = value; return 0; }
+__STATIC_FORCEINLINE uint32_t __STREXH(uint16_t value, volatile uint16_t *addr) { *addr = value; return 0; }
+__STATIC_FORCEINLINE uint32_t __STREXW(uint32_t value, volatile uint32_t *addr) { *addr = value; return 0; }
+__STATIC_FORCEINLINE void __CLREX(void) { }
+
+__STATIC_FORCEINLINE int32_t __SSAT(int32_t val, uint32_t sat)
+{
+    if (sat >= 1u && sat <= 32u) {
+        const int32_t max = (int32_t)((1u << (sat - 1u)) - 1u);
+        const int32_t min = -1 - max;
+        return val > max ? max : (val < min ? min : val);
+    }
+    return val;
+}
+__STATIC_FORCEINLINE uint32_t __USAT(int32_t val, uint32_t sat)
+{
+    if (sat <= 31u) {
+        const uint32_t max = ((1u << sat) - 1u);
+        return val > (int32_t)max ? max : (val < 0 ? 0u : (uint32_t)val);
+    }
+    return (uint32_t)val;
+}
+
+// registres du microcontrôleur : tous les fichiers (y compris la bibliothèque du fabricant) voient la mémoire simulée
+#include "stm32f4xx.h"
+#include "simulee/carte_simulee.h"
diff --git a/src/platform/STM32/simulee/config.c b/src/platform/STM32/simulee/config.c
new file mode 100644
index 0000000..917e285
--- /dev/null
+++ b/src/platform/STM32/simulee/config.c
@@ -0,0 +1,64 @@
+/*
+ * TrueGlide - carte simulée : mémoire des réglages, à la place de common/stm32/config_flash.c.
+ * Free software under the GPL-3.0 license, WITHOUT ANY WARRANTY; see the LICENSE file.
+ *
+ * La zone a la taille de celle de la vraie carte. Comme la mémoire flash, elle est effacée (0xFF) quand une
+ * sauvegarde commence au début de la zone. Elle est gardée dans le fichier eeprom.bin (mémoire de la page dans le
+ * navigateur, que la page conserve d'un redémarrage à l'autre).
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "platform.h"
+
+#include "config/config_streamer.h"
+#include "config/config_streamer_impl.h"
+
+#include "simulee/liaison.h"
+
+#define FICHIER "eeprom.bin"
+
+__attribute__((aligned(8))) uint8_t tgConfigZone[TG_CONFIG_TAILLE];
+
+void tgConfigCharger(void)
+{
+    memset(tgConfigZone, 0xff, sizeof(tgConfigZone));
+    FILE *f = fopen(FICHIER, "rb");
+    if (f) {
+        const size_t n = fread(tgConfigZone, 1, sizeof(tgConfigZone), f);
+        fclose(f);
+        printf("[carte] réglages lus : %u octets\n", (unsigned)n);
+    }
+}
+
+void configUnlock(void)
+{
+}
+
+void configClearFlags(void)
+{
+}
+
+configStreamerResult_e configWriteWord(uintptr_t address, config_streamer_buffer_type_t *buffer)
+{
+    const uintptr_t debut = (uintptr_t)tgConfigZone;
+    if (address < debut || address + CONFIG_STREAMER_BUFFER_SIZE > debut + sizeof(tgConfigZone)) {
+        return CONFIG_RESULT_ADDRESS_INVALID;
+    }
+    if (address == debut) {
+        memset(tgConfigZone, 0xff, sizeof(tgConfigZone)); // effacement du secteur, comme la mémoire flash
+    }
+    memcpy((void *)address, buffer, CONFIG_STREAMER_BUFFER_SIZE);
+    return CONFIG_RESULT_SUCCESS;
+}
+
+void configLock(void)
+{
+    FILE *f = fopen(FICHIER, "wb");
+    if (f) {
+        fwrite(tgConfigZone, 1, sizeof(tgConfigZone), f);
+        fclose(f);
+    }
+}
diff --git a/src/platform/STM32/simulee/i2c.c b/src/platform/STM32/simulee/i2c.c
new file mode 100644
index 0000000..4f839da
