+++ b/src/platform/STM32/simulee/memoire.c
@@ -0,0 +1,38 @@
+/*
+ * TrueGlide - carte simulée : mémoire des registres du microcontrôleur (voir carte_simulee.h).
+ * Free software under the GPL-3.0 license, WITHOUT ANY WARRANTY; see the LICENSE file.
+ */
+
+#include <stdint.h>
+
+#include "platform.h"
+
+__attribute__((aligned(4096))) uint8_t tgPeripheriques[TG_PERIPH_TAILLE];
+__attribute__((aligned(4096))) uint8_t tgAhb2[TG_AHB2_TAILLE];
+__attribute__((aligned(4096))) uint8_t tgCoeur[TG_COEUR_TAILLE];
+
+// identifiant unique de la puce simulée (remplacé par la page, par exemple par celui de la carte récoltée)
+uint32_t tgIdentifiantUnique[3] = { 0x54475349, 0x4d554c45, 0x45000001 };
+
+// niveau d'interruption simulé (build/atomic.h)
+uint8_t atomic_BASEPRI;
+uint32_t tgPrimask;
+
+// mémoire système : taille de la flash (1024 Ko pour la F405) et étalonnages d'usine typiques de la STM32F4
+// (tension de référence interne, capteur de température à 30 °C et 110 °C)
+uint8_t tgSysteme[TG_SYSTEME_TAILLE] = {
+    [0x222] = 0x00, [0x223] = 0x04,
+    [0x22A] = 0xF7, [0x22B] = 0x05,
+    [0x22C] = 0xAC, [0x22D] = 0x03,
+    [0x22E] = 0xC2, [0x22F] = 0x04,
+};
+
+// valeurs des registres à la mise sous tension, quand elles comptent pour le firmware
+void tgMemoireInit(void)
+{
+    // mesures internes de l'ADC1 (canaux injectés) : tension de référence nominale (étalonnage d'usine, soit 3,3 V)
+    // et capteur de température de la puce à 35 °C ; conversion terminée
+    ADC1->JDR1 = 0x05F7;
+    ADC1->JDR2 = 0x03AC + 17;
+    ADC1->SR |= ADC_FLAG_JEOC;
+}
diff --git a/src/platform/STM32/simulee/peripheriques.c b/src/platform/STM32/simulee/peripheriques.c
new file mode 100644
index 0000000..d6a41d4
--- /dev/null
+++ b/src/platform/STM32/simulee/peripheriques.c
@@ -0,0 +1,371 @@
+/*
+ * TrueGlide - carte simulée : puces de la carte.
+ * Free software under the GPL-3.0 license, WITHOUT ANY WARRANTY; see the LICENSE file.
+ *
+ * Chaque puce répond comme la vraie, juste assez pour que les pilotes du firmware la reconnaissent et la règlent :
+ * mêmes registres d'identification et d'état. La carte simulée est posée à plat et immobile : gyroscope à zéro,
+ * accéléromètre à 1 g sur l'axe Z. Aucune vidéo n'arrive sur la puce OSD. La mémoire flash est vide au démarrage.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "platform.h"
+
+#include "drivers/bus_i2c.h"
+#include "drivers/io.h"
+
+#include "simulee/peripheriques.h"
+
+// ---------------------------------------------------------------------------------------------------------------
+// gyroscope et accéléromètre InvenSense ICM42688P (registres en 4 bancs, lecture : bit 7 de l'adresse à 1)
+
+#define ICM_BANQUE_SEL      0x76
+#define ICM_WHO_AM_I        0x75
+#define ICM_DEVICE_CONFIG   0x11
+#define ICM_ACCEL_Z1        0x23
+
+static uint8_t icmRegistres[4][128];
+static uint8_t icmBanque;
+static uint8_t icmAdresse;
+static bool icmLecture;
+static int icmPosition;
+
+static void icmReinitialiser(void)
+{
+    memset(icmRegistres, 0, sizeof(icmRegistres));
+    icmBanque = 0;
+}
+
+static uint8_t icmValeur(uint8_t reg)
+{
+    if (reg == ICM_WHO_AM_I) {
+        return 0x47; // ICM42688P
+    }
+    if (reg == ICM_BANQUE_SEL) {
+        return icmBanque;
+    }
+    if (icmBanque == 0 && reg >= 0x1D && reg <= 0x2A) {
+        // température (25 °C : 0), accéléromètre (Z : 1 g à ±16 g, 2048 points par g), gyroscope (immobile)
+        return reg == ICM_ACCEL_Z1 ? 0x08 : 0x00;
+    }
+    return icmRegistres[icmBanque][reg & 0x7F];
+}
+
+static void icmDebut(void)
+{
+    icmPosition = 0;
+}
+
+static uint8_t icmOctet(uint8_t envoye)
+{
+    if (icmPosition++ == 0) {
+        icmAdresse = envoye & 0x7F;
+        icmLecture = envoye & 0x80;
+        return 0xFF;
+    }
+    const uint8_t reg = icmAdresse++;
+    if (icmLecture) {
+        return icmValeur(reg);
+    }
+    if (reg == ICM_BANQUE_SEL) {
+        icmBanque = envoye & 0x03;
+    } else if (icmBanque == 0 && reg == ICM_DEVICE_CONFIG && (envoye & 0x01)) {
+        icmReinitialiser(); // réinitialisation logicielle
+    } else {
+        icmRegistres[icmBanque][reg & 0x7F] = envoye;
+    }
+    return 0xFF;
+}
+
+static void rien(void)
+{
+}
+
+static const tgPuceSpi_t icm42688p = { icmDebut, icmOctet, rien };
+
+// ---------------------------------------------------------------------------------------------------------------
+// puce OSD MAX7456 (ou AT7456E) : paires adresse / donnée ; lecture : bit 7 de l'adresse à 1
+
+#define MAX_DMM     0x04
+#define MAX_DMDI    0x07
+#define MAX_OSDM    0x0C
+#define MAX_STAT    0x20
+#define MAX_FIN     0xFF
+
+static uint8_t maxRegistres[128];
+static enum { MAX_ADRESSE, MAX_DONNEE, MAX_LIRE, MAX_SUITE } maxEtat;
+static uint8_t maxAdresse;
+
+static void maxDebut(void)
+{
+    maxEtat = MAX_ADRESSE;
+}
+
+static uint8_t maxOctet(uint8_t envoye)
+{
+    switch (maxEtat) {
+    case MAX_ADRESSE:
+        if (envoye == MAX_FIN) {
+            return 0xFF;
+        }
+        maxAdresse = envoye & 0x7F;
+        maxEtat = (envoye & 0x80) ? MAX_LIRE : MAX_DONNEE;
+        return 0xFF;
+    case MAX_LIRE:
+        maxEtat = MAX_ADRESSE;
+        if (maxAdresse == MAX_STAT) {
+            return 0x04; // aucune caméra branchée : perte de synchronisation, mémoire des caractères libre
+        }
+        return maxRegistres[maxAdresse];
+    case MAX_DONNEE:
+        // le bit de réinitialisation de VM0 retombe tout seul
+        maxRegistres[maxAdresse] = maxAdresse == 0x00 ? (envoye & ~0x02) : envoye;
+        maxEtat = (maxAdresse == MAX_DMDI && (maxRegistres[MAX_DMM] & 0x01)) ? MAX_SUITE : MAX_ADRESSE;
+        return 0xFF;
+    case MAX_SUITE:
+        // écriture de l'écran en incrémentation automatique, jusqu'à 0xFF
+        if (envoye == MAX_FIN) {
+            maxEtat = MAX_ADRESSE;
+        }
+        return 0xFF;
+    }
+    return 0xFF;
+}
+
+static void maxInitialiser(void)
+{
+    maxRegistres[MAX_OSDM] = 0x1B; // valeur à la mise sous tension
+}
+
+static const tgPuceSpi_t max7456 = { maxDebut, maxOctet, rien };
+
+// ---------------------------------------------------------------------------------------------------------------
+// mémoire flash Winbond W25Q128FV (16 Mo), vide au démarrage ; pages de 4 Ko créées à la première écriture
+
+#define FL_TAILLE       (16u * 1024u * 1024u)
+#define FL_PAGE         4096u
+
+static uint8_t *flPages[FL_TAILLE / FL_PAGE];
+static uint8_t flCommande;
+static uint32_t flAdresse;
+static int flPosition;
+static bool flEcritureAutorisee;
+
+static uint8_t flLireOctet(uint32_t adresse)
+{
+    adresse %= FL_TAILLE;
+    const uint8_t *page = flPages[adresse / FL_PAGE];
+    return page ? page[adresse % FL_PAGE] : 0xFF;
+}
+
+static void flProgrammer(uint32_t adresse, uint8_t valeur)
+{
+    adresse %= FL_TAILLE;
+    uint8_t **page = &flPages[adresse / FL_PAGE];
+    if (!*page) {
+        if (valeur == 0xFF) {
+            return;
+        }
+        *page = malloc(FL_PAGE);
+        memset(*page, 0xFF, FL_PAGE);
+    }
+    (*page)[adresse % FL_PAGE] &= valeur; // la programmation ne fait que passer des bits à 0
+}
+
+static void flEffacer(uint32_t adresse, uint32_t taille)
+{
+    adresse = (adresse % FL_TAILLE) & ~(taille - 1);
+    for (uint32_t p = adresse / FL_PAGE; p < (adresse + taille) / FL_PAGE; p++) {
+        free(flPages[p]);
+        flPages[p] = NULL;
+    }
+}
+
+static void flDebut(void)
+{
+    flPosition = 0;
+}
+
+static uint8_t flOctet(uint8_t envoye)
+{
+    const int position = flPosition++;
+    if (position == 0) {
+        flCommande = envoye;
+        flAdresse = 0;
+        if (envoye == 0x06) {
+            flEcritureAutorisee = true;
+        } else if (envoye == 0x04) {
+            flEcritureAutorisee = false;
+        } else if ((envoye == 0xC7 || envoye == 0x60) && flEcritureAutorisee) {
+            flEffacer(0, FL_TAILLE);
+            flEcritureAutorisee = false;
+        }
+        return 0xFF;
+    }
+    switch (flCommande) {
+    case 0x9F: { // identification JEDEC : Winbond, W25Q128FV
+        static const uint8_t id[] = { 0xEF, 0x40, 0x18, 0x00 };
+        return position <= 4 ? id[position - 1] : 0x00;
+    }
+    case 0x05: // état : jamais occupée
+        return flEcritureAutorisee ? 0x02 : 0x00;
+    case 0x35:
+    case 0x15:
+        return 0x00;
+    case 0x03: // lecture
+        if (position <= 3) {
+            flAdresse = (flAdresse << 8) | envoye;
+            return 0xFF;
+        }
+        return flLireOctet(flAdresse++);
+    case 0x0B: // lecture rapide : un octet d'attente après l'adresse
+        if (position <= 3) {
+            flAdresse = (flAdresse << 8) | envoye;
+            return 0xFF;
+        }
+        return position == 4 ? 0xFF : flLireOctet(flAdresse++);
+    case 0x02: // programmation d'une page
+        if (position <= 3) {
+            flAdresse = (flAdresse << 8) | envoye;
+            return 0xFF;
+        }
+        if (flEcritureAutorisee) {
+            flProgrammer((flAdresse & ~0xFFu) | ((flAdresse + (uint32_t)(position - 4)) & 0xFFu), envoye);
+        }
+        return 0xFF;
+    case 0x20: // effacement 4 Ko
+    case 0xD8: // effacement 64 Ko
+        flAdresse = (flAdresse << 8) | envoye;
+        if (position == 3 && flEcritureAutorisee) {
+            flEffacer(flAdresse, flCommande == 0x20 ? 4096u : 65536u);
+            flEcritureAutorisee = false;
+        }
+        return 0xFF;
+    default:
+        return 0xFF;
+    }
+}
+
+static void flFin(void)
+{
+    if (flCommande == 0x02) {
+        flEcritureAutorisee = false;
+    }
+}
+
+static const tgPuceSpi_t w25q128 = { flDebut, flOctet, flFin };
+
+// ---------------------------------------------------------------------------------------------------------------
+// câblage de la vraie carte (config.h) : broche CS -> puce
+
+const tgPuceSpi_t *tgPuceSpi(IO_t cs)
+{
+    static bool pret;
+    if (!pret) {
+        icmReinitialiser();
+        maxInitialiser();
+        pret = true;
+    }
+#if defined(GYRO_1_CS_PIN) && defined(USE_GYRO_SPI_ICM42688P)
+    if (cs == IOGetByTag(IO_TAG(GYRO_1_CS_PIN))) {
+        return &icm42688p;
+    }
+#endif
+#if defined(MAX7456_SPI_CS_PIN) && defined(USE_MAX7456)
+    if (cs == IOGetByTag(IO_TAG(MAX7456_SPI_CS_PIN))) {
+        return &max7456;
+    }
+#endif
+#if defined(FLASH_CS_PIN) && defined(USE_FLASH_W25Q128FV)
+    if (cs == IOGetByTag(IO_TAG(FLASH_CS_PIN))) {
+        return &w25q128;
+    }
+#endif
+    return NULL;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// baromètre Infineon DPS310 (I2C, adresse 0x76) : posé au niveau de la mer, 1013,25 hPa et 25 °C. Les mesures
+// brutes restent à zéro ; les coefficients d'étalonnage donnent alors exactement ces valeurs (c0 = 50 : 25 °C,
+// c00 = 101325 Pa, les autres à zéro).
+
+static uint8_t dpsRegistres[0x30];
+
+static void dpsInitialiser(void)
+{
+    memset(dpsRegistres, 0, sizeof(dpsRegistres));
+    dpsRegistres[0x0D] = 0x10;                  // identifiant : DPS310
+    dpsRegistres[0x08] = 0xF0;                  // coefficients prêts, capteur prêt, mesures prêtes
+    dpsRegistres[0x10] = 0x03;                  // c0 = 50
+    dpsRegistres[0x11] = 0x20;
+    dpsRegistres[0x13] = 0x18;                  // c00 = 101325 (0x18BCD)
+    dpsRegistres[0x14] = 0xBC;
+    dpsRegistres[0x15] = 0xD0;
+}
+
+static bool dpsEcrire(uint8_t reg, uint8_t nombre, const uint8_t *octets)
+{
+    for (int i = 0; i < nombre; i++, reg++) {
+        if (reg == 0x0C && (octets[i] & 0x0F) == 0x09) {
+            dpsInitialiser(); // réinitialisation logicielle
+        } else if (reg == 0x08) {
+            dpsRegistres[0x08] = 0xF0 | (octets[i] & 0x07); // l'état reste « prêt », seul le mode change
+        } else if (reg < sizeof(dpsRegistres) && reg != 0x0D) {
+            dpsRegistres[reg] = octets[i];
+        }
+    }
+    return true;
+}
+
+static bool dpsLire(uint8_t reg, uint8_t nombre, uint8_t *octets)
+{
+    for (int i = 0; i < nombre; i++, reg++) {
+        octets[i] = reg < sizeof(dpsRegistres) ? dpsRegistres[reg] : 0x00;
+    }
+    return true;
+}
+
+static bool i2cPret;
+
+static void i2cPreparer(void)
+{
+    if (!i2cPret) {
+        dpsInitialiser();
+        i2cPret = true;
+    }
+}
+
+bool tgI2cEcrire(int bus, uint8_t adresse, uint8_t reg, uint8_t nombre, const uint8_t *octets)
+{
+    i2cPreparer();
+#if defined(USE_BARO_DPS310) && defined(BARO_I2C_INSTANCE)
+    if (bus == BARO_I2C_INSTANCE && adresse == 0x76) {
+        return dpsEcrire(reg, nombre, octets);
+    }
+#endif
+    UNUSED(bus);
+    UNUSED(adresse);
+    UNUSED(reg);
+    UNUSED(nombre);
+    UNUSED(octets);
+    return false;
+}
+
+bool tgI2cLire(int bus, uint8_t adresse, uint8_t reg, uint8_t nombre, uint8_t *octets)
+{
+    i2cPreparer();
+#if defined(USE_BARO_DPS310) && defined(BARO_I2C_INSTANCE)
+    if (bus == BARO_I2C_INSTANCE && adresse == 0x76) {
+        return dpsLire(reg, nombre, octets);
+    }
+#endif
+    UNUSED(bus);
+    UNUSED(adresse);
+    UNUSED(reg);
+    UNUSED(nombre);
+    UNUSED(octets);
+    return false;
+}
diff --git a/src/platform/STM32/simulee/peripheriques.h b/src/platform/STM32/simulee/peripheriques.h
new file mode 100644
index 0000000..4be32fe
--- /dev/null
+++ b/src/platform/STM32/simulee/peripheriques.h
@@ -0,0 +1,25 @@
+/*
+ * TrueGlide - carte simulée : puces reliées aux bus de la carte (gyroscope, OSD, mémoire flash, baromètre).
+ * Free software under the GPL-3.0 license, WITHOUT ANY WARRANTY; see the LICENSE file.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "drivers/io_types.h"
+
+// une puce sur un bus SPI : début (CS au niveau bas), un octet échangé, fin (CS au niveau haut)
+typedef struct {
+    void (*debut)(void);
+    uint8_t (*octet)(uint8_t envoye);
+    void (*fin)(void);
+} tgPuceSpi_t;
+
+// puce sélectionnée par cette broche CS, d'après le config.h de la vraie carte (NULL : rien ne répond)
+const tgPuceSpi_t *tgPuceSpi(IO_t cs);
+
+// une puce sur un bus I2C (adresse sur 7 bits) : écriture et lecture de registres ; false si personne ne répond
+bool tgI2cEcrire(int bus, uint8_t adresse, uint8_t reg, uint8_t nombre, const uint8_t *octets);
+bool tgI2cLire(int bus, uint8_t adresse, uint8_t reg, uint8_t nombre, uint8_t *octets);
diff --git a/src/platform/STM32/simulee/spi.c b/src/platform/STM32/simulee/spi.c
new file mode 100644
index 0000000..808f87d
--- /dev/null
+++ b/src/platform/STM32/simulee/spi.c
@@ -0,0 +1,60 @@
+/*
+ * TrueGlide - carte simulée : bus SPI.
+ * Free software under the GPL-3.0 license, WITHOUT ANY WARRANTY; see the LICENSE file.
+ *
+ * Le pilote SPI du microcontrôleur (STM32/bus_spi_stdperiph.c) est gardé pour tout le reste (broches, horloges,
+ * DMA réservés : `resource`, `dma` restent ceux de la vraie carte). Seuls les échanges d'octets passent ici : chaque
+ * transfert est remis à la puce simulée choisie par sa broche de sélection (CS), comme sur la carte. Les transferts
+ * se font sans DMA, tout de suite, et les fonctions de rappel des pilotes sont appelées comme à la fin d'un DMA.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "platform.h"
+
+#ifdef USE_SPI
+
+#include "drivers/bus_spi.h"
+#include "drivers/bus_spi_impl.h"
+#include "drivers/io.h"
+
+#include "simulee/peripheriques.h"
+
+static const extDevice_t *appareil;     // appareil dont la séquence est en cours
+static bool selectionne;                // broche CS au niveau bas
+
+void spiSequenceStart(const extDevice_t *dev)
+{
+    dev->bus->initSegment = true;
+    appareil = dev;
+    selectionne = false;
+    spiProcessSegmentsPolled(dev);
+}
+
+bool spiInternalReadWriteBufPolled(SPI_TypeDef *spiInstance, const uint8_t *txData, uint8_t *rxData, int len)
+{
+    UNUSED(spiInstance);
+    const tgPuceSpi_t *puce = appareil ? tgPuceSpi(appareil->busType_u.spi.csnPin) : NULL;
+
+    if (puce && !selectionne) {
+        puce->debut();
+    }
+    selectionne = true;
+    for (int i = 0; i < len; i++) {
+        const uint8_t b = txData ? txData[i] : 0xFF;
+        const uint8_t r = puce ? puce->octet(b) : 0xFF;
+        if (rxData) {
+            rxData[i] = r;
+        }
+    }
+    if (appareil && appareil->bus->curSegment->negateCS) {
+        if (puce) {
+            puce->fin();
+        }
+        selectionne = false;
+    }
+    return true;
+}
+
+#endif
diff --git a/src/platform/STM32/simulee/systeme.c b/src/platform/STM32/simulee/systeme.c
new file mode 100644
index 0000000..4821ead
--- /dev/null
+++ b/src/platform/STM32/simulee/systeme.c
@@ -0,0 +1,194 @@
+/*
+ * TrueGlide - carte simulée : démarrage, temps et redémarrage, à la place des fichiers du microcontrôleur
+ * (common/stm32/system.c, STM32/system_stm32f4xx.c, STM32/persistent.c).
+ * Free software under the GPL-3.0 license, WITHOUT ANY WARRANTY; see the LICENSE file.
+ *
+ * Le temps vient de l'horloge de l'ordinateur ou du navigateur. L'horloge simulée du processeur tourne à la
+ * fréquence de la vraie carte (SystemCoreClock), pour que les durées affichées en cycles restent justes.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+#include "platform.h"
+
+#include "drivers/io.h"
+#include "drivers/io_impl.h"
+#include "drivers/light_led.h"
+#include "drivers/persistent.h"
+#include "drivers/system.h"
+#include "drivers/time.h"
+
+#include "simulee/liaison.h"
+
+// fréquence du processeur de la vraie carte (STM32F405 : 168 MHz)
+uint32_t SystemCoreClock = 168000000;
+static uint32_t valeurHse;
+
+// horloge système tirée de la PLL (2 : PLLP), elle-même tirée du quartz externe (1 : HSE), comme la vraie carte
+int SystemSYSCLKSource(void)
+{
+    return 2;
+}
+
+int SystemPLLSource(void)
+{
+    return 1;
+}
+
+static struct timespec debut;
+
+static uint64_t nanosDepuisDebut(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (uint64_t)(t.tv_sec - debut.tv_sec) * 1000000000ull + (uint64_t)t.tv_nsec - (uint64_t)debut.tv_nsec;
+}
+
+void systemInit(void)
+{
+    clock_gettime(CLOCK_MONOTONIC, &debut);
+    tgMemoireInit();
+    tgConfigCharger();
+    persistentObjectInit();
+}
+
+void systemClockSetHSEValue(uint32_t frequency)
+{
+    valeurHse = frequency;
+    UNUSED(valeurHse);
+}
+
+void cycleCounterInit(void)
+{
+}
+
+bool isMPUSoftReset(void)
+{
+    return false;
+}
+
+void OverclockRebootIfNecessary(uint32_t overclockLevel)
+{
+    UNUSED(overclockLevel);
+}
+
+uint32_t micros(void)
+{
+    return (uint32_t)(nanosDepuisDebut() / 1000u);
+}
+
+uint32_t microsISR(void)
+{
+    return micros();
+}
+
+uint32_t millis(void)
+{
+    return (uint32_t)(nanosDepuisDebut() / 1000000u);
+}
+
+uint32_t getCycleCounter(void)
+{
+    return (uint32_t)(nanosDepuisDebut() * (SystemCoreClock / 1000000u) / 1000u);
+}
+
+int32_t clockCyclesToMicros(int32_t clockCycles)
+{
+    return clockCycles / (int32_t)(SystemCoreClock / 1000000u);
+}
+
+float clockCyclesToMicrosf(int32_t clockCycles)
+{
+    return clockCycles / (SystemCoreClock / 1000000.0f);
+}
+
+int32_t clockCyclesTo10thMicros(int32_t clockCycles)
+{
+    return 10 * clockCycles / (int32_t)(SystemCoreClock / 1000000u);
+}
+
+int32_t clockCyclesTo100thMicros(int32_t clockCycles)
+{
+    return 100 * clockCycles / (int32_t)(SystemCoreClock / 1000000u);
+}
+
+uint32_t clockMicrosToCycles(uint32_t us)
+{
+    return us * (SystemCoreClock / 1000000u);
+}
+
+void delayMicroseconds(uint32_t us)
+{
+    const uint64_t fin = nanosDepuisDebut() + (uint64_t)us * 1000u;
+    while (nanosDepuisDebut() < fin) {
+    }
+}
+
+void delay(uint32_t ms)
+{
+    delayMicroseconds(ms * 1000u);
+}
+
+// redémarrage : la page relance la carte avec sa mémoire des réglages (comme un redémarrage de la vraie carte)
+void systemReset(void)
+{
+    printf("[carte] redémarrage\n");
+    tgRedemarrer();
+}
+
+void systemResetToBootloader(bootloaderRequestType_e requestType)
+{
+    UNUSED(requestType);
+    printf("[carte] mode chargeur de démarrage : pas dans la carte simulée, redémarrage\n");
+    tgRedemarrer();
+}
+
+void systemResetToMsc(int timezoneOffsetMinutes)
+{
+    UNUSED(timezoneOffsetMinutes);
+    tgRedemarrer();
+}
+
+void systemResetFromMsc(void)
+{
+    tgRedemarrer();
+}
+
+void indicateFailure(failureMode_e mode, int codeRepeatsRemaining)
+{
+    UNUSED(codeRepeatsRemaining);
+    printf("[carte] défaut %d\n", mode);
+}
+
+void failureMode(failureMode_e mode)
+{
+    indicateFailure(mode, 10);
+    systemReset();
+}
+
+void initialiseMemorySections(void)
+{
+}
+
+// objets gardés pendant un redémarrage logiciel (raison du redémarrage, demande de chargeur…)
+static uint32_t objetsPersistants[PERSISTENT_OBJECT_COUNT];
+
+void persistentObjectInit(void)
+{
+}
+
+uint32_t persistentObjectRead(persistentObjectId_e id)
+{
+    return id < PERSISTENT_OBJECT_COUNT ? objetsPersistants[id] : 0;
+}
+
+void persistentObjectWrite(persistentObjectId_e id, uint32_t value)
+{
+    if (id < PERSISTENT_OBJECT_COUNT) {
+        objetsPersistants[id] = value;
+    }
+}
diff --git a/src/platform/STM32/simulee/usb.c b/src/platform/STM32/simulee/usb.c
new file mode 100644
index 0000000..70f50ae
